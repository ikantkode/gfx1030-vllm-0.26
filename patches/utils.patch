+def _on_gfx1030() -> bool:
+    global _ON_GFX1030
+    if _ON_GFX1030 is None:
+        import torch
+
+        _ON_GFX1030 = "gfx1030" in torch.cuda.get_device_properties(
+            0
+        ).gcnArchName
+    return _ON_GFX1030
+
+
+try:  # [gfx1030] module-level Triton kernel (nested JIT broke under graph capture)
+    import triton
+    import triton.language as tl
+
+    @triton.jit
+    def _gfx1030_fp16_gemv_kernel(x_ptr, w_ptr, o_ptr, M, K,
+                                  BLOCK_N: tl.constexpr,
+                                  BLOCK_K: tl.constexpr):
+        pid = tl.program_id(0)
+        offs_m = pid * BLOCK_N + tl.arange(0, BLOCK_N)
+        masks_m = offs_m < M
+        acc = tl.zeros((BLOCK_N,), dtype=tl.float32)
+        for k0 in range(0, tl.cdiv(K, BLOCK_K)):
+            offs_k = k0 * BLOCK_K + tl.arange(0, BLOCK_K)
+            masks_k = offs_k < K
+            xv = tl.load(x_ptr + offs_k, mask=masks_k, other=0.0)
+            w = tl.load(
+                w_ptr + offs_m[:, None] * K + offs_k[None, :],
+                mask=masks_m[:, None] & masks_k[None, :],
+                other=0.0,
+            )
+            acc += tl.sum(w.to(tl.float32) * xv.to(tl.float32)[None, :], axis=1)
+        tl.store(o_ptr + offs_m, acc.to(o_ptr.type.element_ty), mask=masks_m)
+except ImportError:  # pragma: no cover - triton always present in ROCm builds
+    _gfx1030_fp16_gemv_kernel = None
+
+
+def _gfx1030_fp16_gemv(
+    x: "torch.Tensor", weight: "torch.Tensor"
+) -> "torch.Tensor":
+    # [gfx1030] M==1 fp16 GEMV for k>8192 shapes that LLMM1 cannot launch on
+    # (its grid config rejects k>8192, e.g. the GDN out_proj m=2560/k=9216,
+    # which otherwise falls back to rocBLAS at ~700us). Swept: BN=32/BK=128.
+    import triton
+
+    M = weight.shape[0]
+    K = weight.shape[1]
+    out = torch.empty((*x.shape[:-1], M), dtype=x.dtype, device=x.device)
+    x2 = x.reshape(-1, K)
+    o2 = out.reshape(-1, M)
+    for i in range(x2.shape[0]):
+        grid = (triton.cdiv(M, 32),)
+        _gfx1030_fp16_gemv_kernel[grid](
+            x2[i], weight, o2[i], M, K,
+            BLOCK_N=32, BLOCK_K=128, num_warps=4, num_stages=3,
+        )
+    return out
+
